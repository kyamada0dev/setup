#cloud-config
# %USERPROFILE%\.cloud-init\ubuntu-dev.user-data
# # wsl --install -d Ubuntu-26.04 --name ubuntu-dev
# wsl.exe --install --distribution Ubuntu-26.04 --no-launch --name ubuntu-dev
# wsl.exe -d ubuntu-dev -u root exec cloud-init status --wait --format json

package_update: true
package_upgrade: true

timezone: Asia/Tokyo

locale: ja_JP.UTF-8

users:
- name: kyamada
  groups: users,sudo,netdev,audio,adm
  sudo: ALL=(ALL) NOPASSWD:ALL
  shell: /bin/zsh
  lock_passwd: true

write_files:
- path: /etc/wsl.conf
  append: true
  content: |
    [user]
    default=kyamada

packages:
- 7zip
- build-essential
- ca-certificates
- curl
- file
- fzf
- git
- gnupg
- jq
- keychain
- libclang-dev
- libffi-dev
- libgmp-dev
- liblzma-dev
- libncurses-dev
- libsqlite3-dev
- libssl-dev
- libyaml-dev
- libxml2-dev
- libxmlsec1-dev
- llvm
- llvm-dev
- make
- openssh-client
- pkg-config
- procps
- ripgrep
- rustc
- sqlite3
- tk-dev
- tmux
- unzip
- vim
- wget
- zlib1g-dev
- zsh
- xz-utils
